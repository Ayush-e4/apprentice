# Copy this file to .env and fill in your own keys. Never commit .env.
# Every role takes any OpenAI-compatible endpoint: BASE_URL + MODEL (+ API_KEY).
# *_FALLBACK_* endpoints are tried when the primary one fails.
# Prices are USD per 1M tokens, used for the cost charts. Take them from your provider's pricing page.

# Student: small open-weight model, local via Ollama
STUDENT_BASE_URL=http://localhost:11434/v1
STUDENT_MODEL=qwen3:1.7b
STUDENT_API_KEY=
STUDENT_PRICE_IN=0
STUDENT_PRICE_OUT=0
# Qwen3 thinks before answering unless told not to; 1 = append /no_think
STUDENT_NO_THINK=1

# Student fallback: a hosted small open model (e.g. DigitalOcean Inference, OpenRouter, Groq)
STUDENT_FALLBACK_BASE_URL=
STUDENT_FALLBACK_MODEL=
STUDENT_FALLBACK_API_KEY=
STUDENT_FALLBACK_PRICE_IN=0
STUDENT_FALLBACK_PRICE_OUT=0

# Teacher: large open-weight model via Command Code's Provider API
TEACHER_BASE_URL=https://api.commandcode.ai/provider/v1
TEACHER_MODEL=glm-5.1
TEACHER_API_KEY=
TEACHER_PRICE_IN=
TEACHER_PRICE_OUT=

# Teacher fallback (e.g. DigitalOcean Inference)
TEACHER_FALLBACK_BASE_URL=
TEACHER_FALLBACK_MODEL=
TEACHER_FALLBACK_API_KEY=
TEACHER_FALLBACK_PRICE_IN=
TEACHER_FALLBACK_PRICE_OUT=

# Optional embeddings for memory search (falls back to word overlap if unset or unreachable)
# e.g. EMBED_BASE_URL=http://localhost:11434/v1 and EMBED_MODEL=nomic-embed-text (ollama pull nomic-embed-text)
EMBED_BASE_URL=
EMBED_MODEL=
EMBED_API_KEY=

# Memory search
MEMORY_K=3
MEMORY_MIN_SIM=0.55

# Optional, not wired in yet: router and judge
TYPESAFE_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
