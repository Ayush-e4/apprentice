# Copy this file to .env and fill in your own keys. Never commit .env.

# Teacher: large open-weight model via Command Code's OpenAI-compatible Provider API
COMMANDCODE_API_KEY=
COMMANDCODE_BASE_URL=https://api.commandcode.ai/provider/v1
TEACHER_MODEL=glm-5.1

# Student: small open-weight model served locally by Ollama
OLLAMA_BASE_URL=http://localhost:11434/v1
STUDENT_MODEL=qwen3:1.7b

# Router: Jev by TypeSafe AI (optional; falls back to a built-in router)
TYPESAFE_API_KEY=

# Judge (evaluation only, optional)
OPENAI_API_KEY=
JUDGE_MODEL=gpt-6-luna
ANTHROPIC_API_KEY=
