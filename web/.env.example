# Where the Next app proxies API calls. Copy to .env.local, or set in your shell.
# The browser calls /gw/* and /support-gw/* on this app; next.config.ts rewrites them here.

# Main gateway: Kirana Copilot, /api/stats, /api/traces, /api/evals, /api/health
APPRENTICE_URL=http://localhost:8000

# Gateway that serves the QuickBite support demo (/api/support/*), with its own memory
SUPPORT_URL=http://localhost:8001

# Optional: the public gateway URL shown on /guide (for example a Cloudflare tunnel to the gateway).
# Read at runtime by /api/guide-config, so changing it only needs a restart, not a rebuild.
# Unset: the guide shows http://localhost:8000 and asks readers to use their own gateway's URL.
PUBLIC_GATEWAY_URL=
